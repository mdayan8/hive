# LLM API Configuration (OpenAI-compatible — works with DeepSeek, Qwen, OpenAI, etc.)
# DeepSeek:  https://api.deepseek.com/v1/chat/completions
# Alibaba Qwen (Bailian): https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL_NAME=deepseek-v4-flash

# Model overrides (optional — fall back to LLM_MODEL_NAME if unset)
ORCHESTRATOR_MODEL=
AGENT_MODEL=

# Backward compat (fallback if LLM_API_KEY unset)
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
